# Copy to .env and fill in. Every value here is read by stepbound_be/config.py.

# Postgres connection (SQLAlchemy URL, psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://stepbound:stepbound@localhost:5432/stepbound

# Key the app sends in X-Stepbound-Key. It ships inside the APK, so it is
# not a secret: it only keeps random traffic out. Same value as the app's
# --dart-define=STEPBOUND_TELEMETRY_KEY.
INGEST_KEY=change-me

# Secret used to hash the install ids the phones send (HMAC-SHA256): the
# database never holds the id the phone knows. Keep it secret and stable,
# changing it splits every player in two.
PLAYER_ID_PEPPER=change-me-too-and-keep-it-long

# Bearer token for the /v1/stats and /v1/errors endpoints.
ADMIN_TOKEN=change-me-as-well

# Rate limits per client address (flask-limiter syntax) and their storage.
# memory:// is per process; use redis://... with several gunicorn workers.
INGEST_RATE_LIMIT=60/minute;600/hour
RATELIMIT_STORAGE_URI=memory://

# How many reverse proxies sit in front of the app (for the client address).
TRUSTED_PROXIES=1

# How long data is kept, in days (flask purge).
EVENT_RETENTION_DAYS=395
REPORT_RETENTION_DAYS=180
